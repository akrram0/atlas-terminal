{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Atlas Terminal",
  "version": "0.1.0",
  "identifier": "com.atlas.terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Atlas Terminal",
        "width": 960,
        "height": 600,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      },
      {
        "label": "settings",
        "title": "Settings",
        "width": 640,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "visible": false,
        "center": true,
        "skipTaskbar": true
      }
    ]
  }
}
